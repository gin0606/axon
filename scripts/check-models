#!/usr/bin/env bash
# spec/ の Quint モデルを検査し、spec/README.md の「成功の判定」を満たすかを終了コードで返す。
# 使い方は --help にある。
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
usage: scripts/check-models [--samples N] [--steps N] [TARGET...] [-- QUINT_RUN_ARGS...]

TARGET を省略すると、すべての検査を spec/README.md の「検証結果」と同じ探索量で行う。

  typecheck                      spec/*.qnt の型検査
  test                           record_integration_test の run テスト
  issue_lifecycle
  lifecycle_information
  group_lifecycle[:ENTRY]        ENTRY: main workAndReopen dependAndStart listAndWork readoptAfterClose
  candidate_evaluation[:ENTRY]   ENTRY: queryStep workAndList
  record_integration[:ENTRY]     ENTRY: main divergeAndResolve breakAndRepair crossMoves
                                        reopenUnderDependent reopenAfterInflow

ENTRY を付けないと、その検査のすべての探索を行う。
--samples・--steps は、選んだすべての探索の --max-samples・--max-steps を上書きする。
-- の後の引数は各 quint run にそのまま渡す（例: 反例の再現に -- --seed 0x1234）。

一つの検査の探索を一部だけ選んだときは、invariant の反例と 0 が期待の witness だけを判定し、
未観測の witness は表示だけする。
EOF
}

# 検査ごとの探索: 検査 探索 file samples steps [quint run の追加引数...]
# 検査の名前は invariant と witness を読む spec/<検査>.qnt を指す。通常探索で観測率の低い witness は
# 補助の入口が担うため、同じ検査の探索は witness の観測を合算して判定する。
# samples は、補助の入口が担わない witness が偶然に左右されずに観測される水準を下限とし、
# そのうえで invariant を叩く厚みを加えて決めている。
runs() {
  cat <<'EOF'
issue_lifecycle main spec/issue_lifecycle.qnt 100000 80
lifecycle_information main spec/lifecycle_information.qnt 100000 60
group_lifecycle main spec/group_lifecycle.qnt 5000 150
group_lifecycle workAndReopen spec/lifecycle_reachability.qnt 300 100 --step workAndReopen
group_lifecycle dependAndStart spec/lifecycle_reachability.qnt 300 100 --step dependAndStart
group_lifecycle listAndWork spec/lifecycle_reachability.qnt 300 100 --step listAndWork
group_lifecycle readoptAfterClose spec/lifecycle_reachability.qnt 5000 60 --step readoptAfterClose
candidate_evaluation queryStep spec/candidate_evaluation.qnt 30000 60 --init queryInit --step queryStep
candidate_evaluation workAndList spec/candidate_evaluation.qnt 3000 60 --init queryInit --step workAndList
record_integration main spec/record_integration.qnt 1000 40
record_integration divergeAndResolve spec/record_integration_paths.qnt 400 40 --step divergeAndResolve
record_integration breakAndRepair spec/record_integration_paths.qnt 200 40 --step breakAndRepair
record_integration crossMoves spec/record_integration_paths.qnt 200 12 --step crossMoves
record_integration reopenUnderDependent spec/record_integration_paths.qnt 300 30 --step reopenUnderDependent
record_integration reopenAfterInflow spec/record_integration_paths.qnt 300 20 --step reopenAfterInflow
EOF
}

# record_integration の本実行は 1 trace あたりの計算が重いため、補助の入口が担う witness を外して
# 状態ごとの評価を減らす。
record_integration_main_witnesses="wResolved wGap wGapFilled wSpuriousGapConflict wPrefixSync wSingleSync
  wConverged wCompleteVsRelease wCancelVsStart wTextConflict wNotesFromBoth wDuplicateCreation
  wDuplicateResolved wTerminalGroupGainsChild wUnadoptedAncestor wRepairedAfterSync wWaivedRepair
  wAccept wStart wComplete wReopen wCancel wReconsider wWithdraw wRelease wEdit wMove wAddDep
  wRemoveDep wCreate wGroupCompleted"

# 規則で塞いだ経路と、条件に依らない理由のない詰まっている Group を観測する witness。
# どの探索でも観測されないことを確かめる。
expected_zero() {
  case "$1" in
    group_lifecycle)
      echo wStalledWithoutListedReason wEffectiveWorkingUnderUnadopted wUnadoptedViaComplete \
        wUnadoptedViaMove wUnadoptedViaAcceptOrReopen
      ;;
  esac
}

# module 直下の定義名だけを読む。関数の中の局所的な val は含めない。
names() {
  sed -n -E "s/^  val ($2[A-Za-z0-9_]+)[[:space:]]*=.*/\1/p" "$1"
}

samples=
steps=
targets=()
extra=()
while [ $# -gt 0 ]; do
  case "$1" in
    --samples) samples=${2:?--samples needs a value}; shift 2 ;;
    --steps) steps=${2:?--steps needs a value}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; extra=("$@"); break ;;
    -*) usage >&2; exit 2 ;;
    *) targets+=("$1"); shift ;;
  esac
done
if [ ${#targets[@]} -eq 0 ]; then
  targets=(typecheck test issue_lifecycle lifecycle_information group_lifecycle candidate_evaluation
    record_integration)
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# 選んだ探索を「検査 探索」の行で集め、重複を除く。
check_typecheck=false
check_test=false
: > "$work/selected"
for target in "${targets[@]}"; do
  case "$target" in
    typecheck) check_typecheck=true; continue ;;
    test) check_test=true; continue ;;
  esac
  check=${target%%:*}
  if [ "$check" = "$target" ]; then
    matched=$(runs | awk -v c="$check" '$1 == c { print $1, $2 }')
  else
    matched=$(runs | awk -v c="$check" -v e="${target#*:}" '$1 == c && $2 == e { print $1, $2 }')
  fi
  if [ -z "$matched" ]; then
    echo "unknown target: $target" >&2
    usage >&2
    exit 2
  fi
  printf '%s\n' "$matched" >> "$work/selected"
done

if $check_typecheck; then
  for f in spec/*.qnt; do
    quint typecheck "$f"
  done
fi
if $check_test; then
  quint test spec/record_integration_test.qnt --match Scenario
fi

status=0
summary=()
for check in $(awk '!seen[$1]++ { print $1 }' "$work/selected"); do
  model="spec/$check.qnt"
  invariants=($(names "$model" inv))
  all_witnesses=$(names "$model" w)
  log="$work/$check.log"
  : > "$log"
  : > "$work/$check.witnesses"
  selected=$(awk -v c="$check" '$1 == c && !seen[$2]++ { n++ } END { print n + 0 }' "$work/selected")
  total=$(runs | awk -v c="$check" '$1 == c { n++ } END { print n + 0 }')

  while read -r _ entry file default_samples default_steps args <&3; do
    if ! awk -v c="$check" -v e="$entry" '$1 == c && $2 == e { found = 1 } END { exit !found }' "$work/selected"; then
      continue
    fi
    if [ "$check" = record_integration ] && [ "$entry" = main ]; then
      witnesses=($record_integration_main_witnesses)
    else
      witnesses=($all_witnesses)
    fi
    printf '%s\n' "${witnesses[@]}" >> "$work/$check.witnesses"
    run_args=($args)
    echo "==> $check:$entry ($file)"
    if ! quint run "$file" --invariants "${invariants[@]}" --witnesses "${witnesses[@]}" \
      --max-samples "${samples:-$default_samples}" --max-steps "${steps:-$default_steps}" \
      --backend rust --verbosity 1 ${run_args[@]+"${run_args[@]}"} ${extra[@]+"${extra[@]}"} | tee -a "$log"; then
      echo "FAILED: $check:$entry: quint run failed (a counterexample or an error)" >&2
      exit 1
    fi
  done 3< <(runs | awk -v c="$check" '$1 == c')

  # 同じ検査のすべての探索を合わせた witness ごとの観測 trace 数で判定する。
  if result=$(awk -v zero="$(expected_zero "$check")" -v partial=$([ "$selected" -lt "$total" ] && echo 1 || echo 0) '
    BEGIN { n = split(zero, z, " "); for (i = 1; i <= n; i++) expected_zero[z[i]] = 1 }
    FILENAME == ARGV[1] { gsub(/\033\[[0-9;]*m/, "")
      if (match($0, /^[A-Za-z0-9_]+ was witnessed in [0-9]+ trace/)) { seen[$1] += $5 }
      next }
    !listed[$1]++ { order[++count] = $1 }
    END {
      bad = 0
      for (i = 1; i <= count; i++) {
        w = order[i]
        if (w in expected_zero) {
          if (seen[w] > 0) { print "  observed although expected to be 0: " w " (" seen[w] " traces)"; bad = 1 }
        } else if (seen[w] == 0) {
          print "  not observed: " w
          if (!partial) bad = 1
        }
      }
      if (partial) print "  (only some explorations were selected; unobserved witnesses are not judged)"
      exit bad
    }' "$log" "$work/$check.witnesses"); then
    ok=true
  else
    ok=false
  fi
  if [ -n "$result" ]; then
    printf '%s\n' "$result"
  fi
  if $ok; then
    summary+=("ok      $check")
  else
    summary+=("FAILED  $check")
    status=1
  fi
done

if [ ${#summary[@]} -gt 0 ]; then
  echo
  printf '%s\n' "${summary[@]}"
fi
exit "$status"
