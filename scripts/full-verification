#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

python3 scripts/update-plugin-versions.py --check
python3 scripts/test-plugin-versions.py
python3 scripts/test-release.py
scripts/check-core-deps
cargo fmt --check
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
cargo test --locked --workspace
# The GUI turns on serde_json features for the whole build; the CLI is released without them.
cargo test --locked
cargo run --locked --quiet -- storage check
