#!/bin/sh
# GUI を macOS のアプリ（target/release/bundle/osx/Axon.app）にまとめる。
# 引数は cargo bundle に渡す。`--target <triple>` を渡すと target/<triple>/release/bundle/osx に作る。
# cargo-bundle はアイコンのパスを起動ディレクトリから解決し、見つからなくてもアイコンなしで
# 作るため、crate のディレクトリで実行する。
set -eu

cd "$(dirname "$0")/../crates/axon-gui"
cargo bundle --release --format osx "$@"
