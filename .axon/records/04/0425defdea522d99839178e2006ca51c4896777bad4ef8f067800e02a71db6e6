\"kind\":\"Start\",\"actor\":\"codex\",\"reason\":null,\"at\":\"2026-09-06T11:05:37.597408Z\"},\"link\":{\"owner\":\"axon-a783e2\",\"stream\":\"State\",\"parents\":[\"progress-73e968232a735f026b8acfcbfb6a3e8a\"],\"origin\":\"Operation\",\"result\":{\"progress\":{\"InProgress\":{\"actor\":\"codex\",\"worktree\":\"/Users/gin0606/.ghq/src/github.com/gin0606/axon-worktrees/file-backend\",\"at\":\"2026-09-06T11:05:37.588562Z\"}},\"disposition\":\"Accepted\",\"resurface\":\"Always\",\"current_revision\":\"rev-60fc9043430a4e36ed83c04970db79a6\",\"last_revision\":\"rev-60fc9043430a4e36ed83c04970db79a6\"}}}\n{\"type\":\"Progress\",\"value\":{\"id\":\"progress-55e62883a71f842905a5b2ba1de3cc14\",\"kind\":\"Done\",\"actor\":\"codex\",\"reason\":null,\"at\":\"2026-09-06T11:12:32.014814Z\"},\"link\":{\"owner\":\"axon-a783e2\",\"stream\":\"State\",\"parents\":[\"progress-488de458c252af2c5dc73e9f0975c513\"],\"origin\":\"Operation\",\"result\":{\"progress\":\"Ended\",\"disposition\":\"Accepted\",\"resurface\":\"Always\",\"current_revision\":\"rev-60fc9043430a4e36ed83c04970db79a6\",\"last_revision\":\"rev-60fc9043430a4e36ed83c04970db79a6\"}}}\n```"}
