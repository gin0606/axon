\"id\":\"progress-ca941a2d9bd1ff761a3d48f6fbf22b50\",\"kind\":\"Start\",\"actor\":\"codex\",\"reason\":null,\"at\":\"2026-09-06T08:37:53.824311Z\"},\"link\":{\"owner\":\"axon-s5sfg9\",\"stream\":\"State\",\"parents\":[\"baseline-79c38c9471a38c0da3b6605d4151837f\"],\"origin\":\"Operation\",\"result\":{\"progress\":{\"InProgress\":{\"actor\":\"codex\",\"worktree\":\"/Users/gin0606/.ghq/src/github.com/gin0606/axon-worktrees/file-backend\",\"at\":\"2026-09-06T08:37:53.816846Z\"}},\"disposition\":\"Accepted\",\"resurface\":\"Always\",\"current_revision\":\"rev-b608fc8ed1d8860afd749c9e8865f215\",\"last_revision\":\"rev-b608fc8ed1d8860afd749c9e8865f215\"}}}\n{\"type\":\"Progress\",\"value\":{\"id\":\"progress-8c3b5486ccc7343549fce569548879c2\",\"kind\":\"Done\",\"actor\":\"codex\",\"reason\":null,\"at\":\"2026-09-06T08:51:19.992282Z\"},\"link\":{\"owner\":\"axon-s5sfg9\",\"stream\":\"State\",\"parents\":[\"progress-ca941a2d9bd1ff761a3d48f6fbf22b50\"],\"origin\":\"Operation\",\"result\":{\"progress\":\"Ended\",\"disposition\":\"Accepted\",\"resurface\":\"Always\",\"current_revision\":\"rev-b608fc8ed1d8860afd749c9e8865f215\",\"last_revision\":\"rev-b608fc8ed1d8860afd749c9e8865f215\"}}}\n```"}
